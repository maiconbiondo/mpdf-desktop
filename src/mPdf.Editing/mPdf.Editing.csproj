<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- PrivateAssets=compile (revisão pós-M11/I1): quem referencia ESTE projeto (src/mPdf.App) não
         recebe mais a referência de COMPILAÇÃO do iText transitivamente — só o binário de runtime
         (necessário: mPdf.Editing.dll chama iText por dentro). Efeito: `using iText...` em
         src/mPdf.App agora falha no COMPILADOR (CS0246 tipo/namespace não encontrado), não só na
         varredura de texto do AgplGuardTests — ver prova de disparo no task-2-report.md. -->
    <PackageReference Include="itext" Version="9.7.0">
      <PrivateAssets>compile</PrivateAssets>
    </PackageReference>
    <PackageReference Include="itext.bouncy-castle-adapter" Version="9.7.0">
      <PrivateAssets>compile</PrivateAssets>
    </PackageReference>
    <!-- Corrigir texto (2026-10-09): pdfSweep (PdfCleaner) remove glifos/pixels de uma área. AGPL como o
         iText. O pacote só traz lib/net461 (NU1701 esperado) — validado em net10 pela Task 1 (POC). -->
    <PackageReference Include="itext.pdfsweep" Version="5.0.7">
      <PrivateAssets>compile</PrivateAssets>
    </PackageReference>
    <!-- itext.cleanup (net461) referencia System.Drawing 4.0.0.0, que no net10 encaminha para
         System.Drawing.Common. Sem este pacote o pdfSweep falha (FileNotFoundException) ao limpar áreas
         com imagem fora do runtime WindowsDesktop (ex.: testes net10.0). Windows-only, licença MIT. -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="mPdf.Editing.Tests" />
    <!-- PageFrame (frame exibido = CropBox ∩ MediaBox) é compartilhado com o carimbo da assinatura. -->
    <InternalsVisibleTo Include="mPdf.Signing" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\sRGB2014.icc" />
  </ItemGroup>

</Project>
