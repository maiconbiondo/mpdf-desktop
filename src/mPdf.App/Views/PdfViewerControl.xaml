<UserControl x:Class="mPdf.App.Views.PdfViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:mPdf.App.ViewModels"
             xmlns:views="clr-namespace:mPdf.App.Views">
    <!-- Definido LOCALMENTE (Task 7, Plano 3a) — StaticResource é resolvido no momento em que este
         UserControl é analisado/carregado (InitializeComponent), não em função de qual Window acaba
         hospedando a instância depois; não dá pra confiar no BoolToVis de MainWindow.Resources aqui. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <DockPanel>
    <!-- Barra de busca (Task 5): dock top, DataContext = Search do documento (própria por aba);
         só fica visível quando IsOpen=true (ver SearchBar.xaml). -->
    <views:SearchBar x:Name="SearchBarControl" DockPanel.Dock="Top" DataContext="{Binding Search}"/>
    <!-- ListBox = ScrollViewer + virtualização prontos; seleção desativada no estilo -->
    <ListBox x:Name="PageList"
             ItemsSource="{Binding Pages}"
             Background="#FF525659"
             BorderThickness="0"
             Focusable="True"
             HorizontalContentAlignment="Center"
             ScrollViewer.HorizontalScrollBarVisibility="Auto"
             VirtualizingPanel.IsVirtualizing="True"
             VirtualizingPanel.VirtualizationMode="Recycling"
             VirtualizingPanel.ScrollUnit="Pixel"
             VirtualizingPanel.CacheLength="1,1"
             VirtualizingPanel.CacheLengthUnit="Page">
        <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:PageViewModel}">
                <Border Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}"
                        Background="White" Margin="0,6" SnapsToDevicePixels="True"
                        Loaded="Page_Loaded" Unloaded="Page_Unloaded"
                        DataContextChanged="Page_DataContextChanged"
                        MouseLeftButtonDown="Page_MouseLeftButtonDown"
                        MouseMove="Page_MouseMove"
                        MouseLeftButtonUp="Page_MouseLeftButtonUp"
                        LostMouseCapture="Page_LostMouseCapture">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.4"/>
                    </Border.Effect>
                    <!-- Grid: mesmo espaço do Image (que preenche o Border via Stretch="Fill") também
                         hospeda o overlay de seleção, sobreposto por cima -->
                    <Grid>
                        <Image Source="{Binding ImageSource}" Stretch="Fill"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <!-- overlay de destaques de busca (Task 5): TODOS os hits desta página, cor
                             translúcida. Rects vivem no PageViewModel (não no container) — sobrevivem
                             à reciclagem de virtualização, o binding só reaparece quando a página é
                             realizada de novo. IsHitTestVisible=False, mesmo motivo da seleção abaixo. -->
                        <ItemsControl ItemsSource="{Binding HighlightRects}" IsHitTestVisible="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Rectangle Fill="#55FFD54F" Width="{Binding Width}" Height="{Binding Height}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- destaque do hit CORRENTE (cor mais opaca, desenhado por cima do anterior). -->
                        <ItemsControl ItemsSource="{Binding CurrentHighlightRects}" IsHitTestVisible="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Rectangle Fill="#88FF8F00" Width="{Binding Width}" Height="{Binding Height}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- overlay de seleção: um retângulo por linha selecionada (SelectionRects, já
                             em px de tela). IsHitTestVisible=False -> nunca rouba o mouse do Border,
                             que é quem trata down/move/up do arrasto. -->
                        <ItemsControl ItemsSource="{Binding SelectionRects}" IsHitTestVisible="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Rectangle Fill="#5533A2FF" Width="{Binding Width}" Height="{Binding Height}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- overlay de seleção de ANOTAÇÃO (Task 7, Plano 3a) — exemplar: overlays acima.
                             Só 1 retângulo (no máx. 1 anotação selecionada no documento inteiro, ver
                             DocumentViewModel.SelectedAnnotation); IsHitTestVisible=False, mesmo motivo
                             dos overlays de seleção/destaque: o Border é quem trata o mouse. -->
                        <Canvas IsHitTestVisible="False">
                            <Rectangle Canvas.Left="{Binding AnnotationSelectionRect.X}"
                                       Canvas.Top="{Binding AnnotationSelectionRect.Y}"
                                       Width="{Binding AnnotationSelectionRect.Width}"
                                       Height="{Binding AnnotationSelectionRect.Height}"
                                       Stroke="#FF2196F3" StrokeThickness="2" Fill="#332196F3"
                                       Visibility="{Binding HasAnnotationSelection, Converter={StaticResource BoolToVis}}"/>
                        </Canvas>
                        <!-- destaque do CAMPO DE FORMULÁRIO selecionado (Task 2, Plano 3c) — exemplar
                             EXATO do overlay de seleção de anotação acima, cor distinta (verde) pra não
                             confundir com marca-texto/anotação selecionada. -->
                        <Canvas IsHitTestVisible="False">
                            <Rectangle Canvas.Left="{Binding FormFieldHighlightRect.X}"
                                       Canvas.Top="{Binding FormFieldHighlightRect.Y}"
                                       Width="{Binding FormFieldHighlightRect.Width}"
                                       Height="{Binding FormFieldHighlightRect.Height}"
                                       Stroke="#FF4CAF50" StrokeThickness="2" Fill="#334CAF50"
                                       Visibility="{Binding HasFormFieldHighlight, Converter={StaticResource BoolToVis}}"/>
                        </Canvas>
                        <!-- destaque do CARIMBO DE ASSINATURA selecionado (Task 4, Plano 4) — exemplar
                             EXATO do overlay de campo de formulário acima, cor distinta (laranja) pra não
                             confundir com marca-texto/anotação/campo selecionado. -->
                        <Canvas IsHitTestVisible="False">
                            <Rectangle Canvas.Left="{Binding SignatureStampHighlightRect.X}"
                                       Canvas.Top="{Binding SignatureStampHighlightRect.Y}"
                                       Width="{Binding SignatureStampHighlightRect.Width}"
                                       Height="{Binding SignatureStampHighlightRect.Height}"
                                       Stroke="#FFFF9800" StrokeThickness="2" Fill="#33FF9800"
                                       Visibility="{Binding HasSignatureStampHighlight, Converter={StaticResource BoolToVis}}"/>
                        </Canvas>
                        <!-- overlay de PRÉVIA de desenho (Task 8, Plano 3a) — Ink (Polyline), Rectangle
                             (rubber-band), Line/Arrow (Line) — exemplar: overlay de seleção de anotação
                             acima. IsHitTestVisible=False, mesmo motivo dos demais overlays: o Border é
                             quem trata o mouse. As 3 formas são mutuamente exclusivas em tempo de
                             execução (só 1 ferramenta de desenho ativa por vez), mas convivem no mesmo
                             Canvas sem custo — as 2 escondidas simplesmente não têm nada pra desenhar. -->
                        <Canvas IsHitTestVisible="False">
                            <Polyline Points="{Binding InkPreviewPoints}"
                                      Stroke="#FF2196F3" StrokeThickness="2"
                                      Visibility="{Binding HasInkPreview, Converter={StaticResource BoolToVis}}"/>
                            <Rectangle Canvas.Left="{Binding RectPreviewRect.X}"
                                       Canvas.Top="{Binding RectPreviewRect.Y}"
                                       Width="{Binding RectPreviewRect.Width}"
                                       Height="{Binding RectPreviewRect.Height}"
                                       Stroke="#FF2196F3" StrokeThickness="2"
                                       Visibility="{Binding HasRectPreview, Converter={StaticResource BoolToVis}}"/>
                            <Line X1="{Binding LinePreviewStart.X}" Y1="{Binding LinePreviewStart.Y}"
                                  X2="{Binding LinePreviewEnd.X}" Y2="{Binding LinePreviewEnd.Y}"
                                  Stroke="#FF2196F3" StrokeThickness="2"
                                  Visibility="{Binding HasLinePreview, Converter={StaticResource BoolToVis}}"/>
                        </Canvas>
                    </Grid>
                </Border>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
    </DockPanel>
</UserControl>
