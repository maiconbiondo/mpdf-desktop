<Window x:Class="mPdf.App.Views.CorrigirTextoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:mPdf.App.Icons"
        Title="Corrigir texto"
        Width="520" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" FontFamily="{DynamicResource Fonte.Inter}">
    <Window.Resources>
        <!-- Mescla o tema LOCALMENTE — mesmo motivo dos outros diálogos (AnnotationTextDialog etc.). -->
        <ResourceDictionary Source="pack://application:,,,/mPdf.App;component/Themes/mPdfTheme.xaml"/>
    </Window.Resources>
    <Border Style="{StaticResource mPdf.Dialog.Superficie}" Margin="16">
        <DockPanel>
            <!-- Header: ícone (T) + título/subtítulo. Arrastável (janela sem chrome). -->
            <Border DockPanel.Dock="Top" Background="Transparent" BorderBrush="{DynamicResource Cor.BordaSutil}"
                    BorderThickness="0,0,0,1" Padding="22,18" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource mPdf.Dialog.IconeHeader}">
                        <TextBlock FontFamily="{DynamicResource Fonte.PhosphorFill}" FontSize="17" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Text="{icons:PhosphorIcon text-t}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="11,0,0,0">
                        <TextBlock Text="Corrigir texto" Style="{StaticResource mPdf.Dialog.Titulo}"/>
                        <TextBlock Text="Troque o texto do trecho selecionado (uma linha)." Style="{StaticResource mPdf.Dialog.Subtitulo}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Rodapé: Cancelar / Aplicar. -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource Cor.FundoDialogoRodape}"
                    BorderBrush="{DynamicResource Cor.BordaSutil}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,13,13" Padding="22,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelarButton" Content="Cancelar" Margin="0,0,10,0" IsCancel="True"
                            Click="Cancelar_Click" Style="{StaticResource mPdf.Button.DialogCancelar}"/>
                    <Button x:Name="AplicarButton" Content="Aplicar" IsDefault="True" Click="Aplicar_Click"
                            Style="{StaticResource mPdf.Button.DialogPrimario}"/>
                </StackPanel>
            </Border>

            <StackPanel Margin="22,20">
                <TextBlock Text="Texto atual" Style="{StaticResource mPdf.Dialog.Label}"/>
                <Border Background="{DynamicResource Cor.Superficie}" BorderBrush="{DynamicResource Cor.BordaSutil}"
                        BorderThickness="1" CornerRadius="{StaticResource Raio.M}" Padding="9,7">
                    <TextBox x:Name="TextoAtualBox" IsReadOnly="True" TextWrapping="NoWrap"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             Foreground="{DynamicResource Cor.TextoSecundario}"
                             CaretBrush="{DynamicResource Cor.TextoSecundario}"
                             SelectionBrush="{DynamicResource Cor.Primaria}" FocusVisualStyle="{x:Null}"/>
                </Border>

                <TextBlock Text="Texto novo" Margin="0,14,0,0" Style="{StaticResource mPdf.Dialog.Label}"/>
                <Border Background="{DynamicResource Cor.Superficie}" BorderBrush="{DynamicResource Cor.Borda}"
                        BorderThickness="1" CornerRadius="{StaticResource Raio.M}" Padding="9,7">
                    <TextBox x:Name="TextoNovoBox" TextWrapping="NoWrap" AcceptsReturn="False"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             Foreground="{DynamicResource Cor.TextoPrimario}"
                             CaretBrush="{DynamicResource Cor.TextoPrimario}"
                             SelectionBrush="{DynamicResource Cor.Primaria}" FocusVisualStyle="{x:Null}"/>
                </Border>

                <!-- Fonte / estilo / tamanho (pré-preenchidos com o estilo detectado no trecho). -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Fonte" FontSize="11" Margin="0,0,0,4"
                                   Foreground="{DynamicResource Cor.TextoSecundario}"/>
                        <!-- Ordem = TextFontFamily (Serif, SansSerif, Monospace); o code-behind mapeia por índice. -->
                        <ComboBox x:Name="FamiliaCombo" SelectedIndex="0" Style="{StaticResource mPdf.Combo}">
                            <ComboBoxItem Content="Com serifa"/>
                            <ComboBoxItem Content="Sem serifa"/>
                            <ComboBoxItem Content="Monoespaçada"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Tamanho (pt) e estilo" FontSize="11" Margin="0,0,0,4"
                                   Foreground="{DynamicResource Cor.TextoSecundario}"/>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{DynamicResource Cor.Superficie}" BorderBrush="{DynamicResource Cor.Borda}"
                                    BorderThickness="1" CornerRadius="{StaticResource Raio.M}" Padding="8,6" Width="64">
                                <TextBox x:Name="TamanhoBox" Background="Transparent" BorderThickness="0" Padding="0"
                                         HorizontalContentAlignment="Right"
                                         Foreground="{DynamicResource Cor.TextoPrimario}"
                                         CaretBrush="{DynamicResource Cor.TextoPrimario}"
                                         SelectionBrush="{DynamicResource Cor.Primaria}" FocusVisualStyle="{x:Null}"/>
                            </Border>
                            <ToggleButton x:Name="NegritoToggle" Content="N" Width="34" Height="32" Margin="8,0,0,0"
                                          FontWeight="Bold" FontSize="13" ToolTip="Negrito"
                                          Style="{StaticResource mPdf.Toggle.Command}"/>
                            <ToggleButton x:Name="ItalicoToggle" Content="I" Width="34" Height="32" Margin="6,0,0,0"
                                          FontStyle="Italic" FontSize="13" ToolTip="Itálico"
                                          Style="{StaticResource mPdf.Toggle.Command}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Cor" FontSize="11" Margin="0,12,0,5"
                           Foreground="{DynamicResource Cor.TextoSecundario}"/>
                <StackPanel x:Name="CorPanel" Orientation="Horizontal"/>

                <!-- Prévia: recorte da página já com a correção aplicada (renderizado fora da UI thread). -->
                <TextBlock Text="Prévia" Margin="0,16,0,0" Style="{StaticResource mPdf.Dialog.Label}"/>
                <Border Background="White" BorderBrush="{DynamicResource Cor.BordaSutil}" BorderThickness="1"
                        CornerRadius="{StaticResource Raio.M}" Padding="8" MinHeight="48">
                    <Image x:Name="PreviaImage" Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="120"
                           HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBlock x:Name="AvisoText" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,6,0,0"
                           FontSize="12" Foreground="{DynamicResource Cor.Erro}"/>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock FontFamily="{DynamicResource Fonte.Phosphor}" FontSize="14" VerticalAlignment="Center"
                               Foreground="{DynamicResource Cor.TextoSecundario}" Text="{icons:PhosphorIcon info}"/>
                    <TextBlock Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource Cor.TextoSecundario}"
                               Text="O texto antigo é removido do arquivo. Para voltar atrás, use Desfazer (Ctrl+Z)."/>
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
