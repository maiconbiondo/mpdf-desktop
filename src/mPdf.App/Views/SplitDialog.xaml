<Window x:Class="mPdf.App.Views.SplitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dividir documento" Height="240" Width="440" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <Window.Resources>
        <!-- Task 2 (Plano 12): mescla o tema LOCALMENTE — mesmo motivo de MainWindow.xaml (Application.
             Current fica null nas sondas STA que constroem este diálogo direto). -->
        <ResourceDictionary Source="pack://application:,,,/mPdf.App;component/Themes/mPdfTheme.xaml"/>
    </Window.Resources>
    <StackPanel Margin="12">
        <TextBlock Text="Intervalos de página (ex.: 1-5, 8, 10-12):" Margin="0,0,0,6"/>
        <TextBox x:Name="RangesTextBox" Margin="0,0,0,12"/>
        <TextBlock Text="Pasta de destino:" Margin="0,0,0,6"/>
        <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Escolher…" Padding="8,2" Margin="8,0,0,0" Click="PickFolder_Click" Style="{StaticResource mPdf.Button.Dialog}"/>
            <TextBox x:Name="FolderTextBox" IsReadOnly="True"/>
        </DockPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="80" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" Style="{StaticResource mPdf.Button.Dialog}"/>
            <Button Content="OK" Width="80" IsDefault="True" Click="Ok_Click" Style="{StaticResource mPdf.Button.Dialog}"/>
        </StackPanel>
    </StackPanel>
</Window>
