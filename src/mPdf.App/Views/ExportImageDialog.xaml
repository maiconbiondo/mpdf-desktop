<Window x:Class="mPdf.App.Views.ExportImageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exportar página como imagem" Height="420" Width="460" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False" Closing="Window_Closing">
    <Window.Resources>
        <!-- Task 2 (Plano 12): mescla o tema LOCALMENTE — mesmo motivo de MainWindow.xaml (Application.
             Current fica null nas sondas STA que constroem este diálogo direto). -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/mPdf.App;component/Themes/mPdfTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <!-- Cancelar (durante a exportação): só habilitado em IsRunning (ver CanCancel do VM). -->
            <Button Content="Cancelar exportação" Width="140" Margin="0,0,8,0"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                    Command="{Binding CancelCommand}" Style="{StaticResource mPdf.Button.Dialog}"/>
            <!-- IsCancel=True: Esc/clique fecham a janela; Window_Closing bloqueia enquanto IsRunning (ver
                 code-behind), mesmo padrão de BatchSignDialog: nunca abandona uma exportação em voo. -->
            <Button Content="Fechar" Width="90" Margin="0,0,8,0" IsCancel="True" Style="{StaticResource mPdf.Button.Dialog}"/>
            <!-- "Exportar" só aparece na fase de opções, desabilitado até um destino ser escolhido
                 (StartCommand.CanExecute). -->
            <Button Content="Exportar" Width="90" IsDefault="True" Command="{Binding StartCommand}"
                    Visibility="{Binding CanEditOptions, Converter={StaticResource BoolToVis}}"
                    Style="{StaticResource mPdf.Button.Dialog}"/>
        </StackPanel>

        <!-- Fase OPÇÕES: formato / alcance / resolução / destino. -->
        <StackPanel Visibility="{Binding CanEditOptions, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Formato:" Margin="0,0,0,4" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton x:Name="PngRadio" Content="PNG" GroupName="Format" IsChecked="True"
                             Checked="PngRadio_Checked" Margin="0,0,16,0"/>
                <RadioButton x:Name="JpgRadio" Content="JPG (qualidade 90)" GroupName="Format"
                             Checked="JpgRadio_Checked"/>
            </StackPanel>

            <TextBlock Text="Alcance:" Margin="0,0,0,4" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton x:Name="CurrentPageRadio" Content="Página atual" GroupName="Range" IsChecked="True"
                             Checked="CurrentPageRadio_Checked" Margin="0,0,16,0"/>
                <RadioButton x:Name="AllPagesRadio" Content="Todas as páginas" GroupName="Range"
                             Checked="AllPagesRadio_Checked"/>
            </StackPanel>

            <TextBlock Text="Resolução:" Margin="0,0,0,4" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton x:Name="Dpi150Radio" Content="150 DPI" GroupName="Dpi" IsChecked="True"
                             Checked="Dpi150Radio_Checked" Margin="0,0,16,0"/>
                <RadioButton x:Name="Dpi300Radio" Content="300 DPI" GroupName="Dpi"
                             Checked="Dpi300Radio_Checked"/>
            </StackPanel>

            <TextBlock Text="Destino:" Margin="0,0,0,4" FontWeight="Bold"/>
            <DockPanel Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Content="Escolher…" Padding="8,2" Margin="8,0,0,0" Click="PickDestination_Click" Style="{StaticResource mPdf.Button.Dialog}"/>
                <TextBox x:Name="DestinationTextBox" IsReadOnly="True"/>
            </DockPanel>
            <!-- Página atual -> arquivo único (SaveFileDialog); todas as páginas -> pasta (OpenFolderDialog,
                 "nome-p001.png" etc, ver ExportImageViewModel.BuildPagePath). Texto muda com o Alcance. -->
            <TextBlock Text="{Binding CanEditOptions}" Visibility="Collapsed"/>
        </StackPanel>

        <!-- Fase EXECUÇÃO: progresso. -->
        <StackPanel Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center">
            <TextBlock Text="{Binding ProgressText}" FontSize="14" TextAlignment="Center" Margin="0,0,0,12"/>
            <ProgressBar IsIndeterminate="True" Height="18"/>
        </StackPanel>

        <!-- Fase CONCLUÍDO: resultado. -->
        <StackPanel Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center">
            <TextBlock Text="Exportação cancelada. As páginas já exportadas foram mantidas."
                       Foreground="#FFB00020" TextWrapping="Wrap" Margin="0,0,0,8" TextAlignment="Center"
                       Visibility="{Binding WasCancelled, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding ErrorMessage, StringFormat='Falha ao exportar: {0}'}"
                       Foreground="#FFB00020" TextWrapping="Wrap" Margin="0,0,0,8" TextAlignment="Center"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed, TargetNullValue=Collapsed}"/>
            <TextBlock Text="{Binding ExportedCount, StringFormat='{}{0} página(s) exportada(s) com sucesso.'}"
                       TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>
    </DockPanel>
</Window>
