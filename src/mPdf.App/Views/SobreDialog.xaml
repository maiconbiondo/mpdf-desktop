<Window x:Class="mPdf.App.Views.SobreDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:mPdf.App.Icons"
        Title="Sobre o mPDF" Width="484" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" FontFamily="{DynamicResource Fonte.Inter}">
    <Window.Resources>
        <!-- Task 2 (Plano 12): mescla o tema LOCALMENTE — mesmo motivo/mesma nota de MainWindow.xaml. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/mPdf.App;component/Themes/mPdfTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Style="{StaticResource mPdf.Dialog.Superficie}" Margin="16">
        <DockPanel>
            <!-- Rodapé: Fechar. -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource Cor.FundoDialogoRodape}"
                    BorderBrush="{DynamicResource Cor.BordaSutil}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,13,13" Padding="22,16">
                <Button Content="Fechar" HorizontalAlignment="Right" IsCancel="True"
                        Style="{StaticResource mPdf.Button.DialogCancelar}"/>
            </Border>

            <StackPanel Margin="24,24">
                <!-- Cabeçalho: logo (vetor) + "mPDF <versão>" + subtítulo (arrasta a janela). -->
                <StackPanel Orientation="Horizontal" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Image Source="{StaticResource Logo.mPDF}" Width="52" Height="52" Margin="0,0,14,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding VersaoAtual, StringFormat='mPDF {0}'}" FontWeight="Bold" FontSize="18"
                                   Foreground="{DynamicResource Cor.TextoPrimario}"/>
                        <TextBlock Text="Leitor, editor e assinador de PDF" FontSize="12"
                                   Foreground="{DynamicResource Cor.TextoSecundario}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Aviso AGPL/licenças (Plano 11). -->
                <TextBlock TextWrapping="Wrap" Margin="0,18,0,0" FontSize="11.5" LineHeight="18"
                           Foreground="{DynamicResource Cor.TextoSecundario}"
                           Text="mPDF é software livre, distribuído sob a licença GNU AGPL-3.0 (por incorporar o iText, componente de assinatura digital de PDF). O código-fonte completo está publicado em github.com/maiconbiondo/mpdf-desktop. Avisos de licença de todos os componentes de terceiros (iText, PDFium, Docnet) estão em docs/licencas, na raiz do repositório."/>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
