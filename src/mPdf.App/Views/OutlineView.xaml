<UserControl x:Class="mPdf.App.Views.OutlineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:mPdf.App.ViewModels"
             xmlns:icons="clr-namespace:mPdf.App.Icons"
             xmlns:conv="clr-namespace:mPdf.App.Converters"
             xmlns:editing="clr-namespace:mPdf.Editing;assembly=mPdf.Editing">
    <!-- Aba "Sumário" (Task 5, Plano 3b) — DataContext esperado: um DocumentViewModel, mesmo contrato
         de ThumbnailsPanel (ver MainWindow.xaml, TabControl dentro do painel esquerdo colapsável).
         TreeView.SelectedItem não é bindable direto em WPF (sem propriedade de dependência própria) —
         SelectedItemChanged no code-behind chama NavigateToOutlineNodeCommand, mesmo espírito de
         Thumb_MouseLeftButtonUp em ThumbnailsPanel.xaml.cs (evento cru da View vira comando do VM). -->
    <!-- Task 2 (Plano 12, rider) — mescla o tema LOCALMENTE, mesmo motivo de ThumbnailsPanel.xaml
         (construído EAGER dentro de MainWindow.xaml — todo `new MainWindow()` de teste passa por
         aqui). -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/mPdf.App;component/Themes/mPdfTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:PaginaMaisUmConverter x:Key="PaginaMaisUm"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource Cor.FundoPainel}">
        <!-- Estado vazio pt-BR (brief) — visível por padrão, Collapsed via DataTrigger quando
             HasOutline=True. Documento sem /Outlines nenhum (fixture-a4, por exemplo) ou o 1º refresh
             assíncrono ainda em voo (ver doc XML de DocumentViewModel.Outline) caem aqui. -->
        <TextBlock Text="Este documento não tem sumário." Foreground="{DynamicResource Cor.TextoSecundario}" FontSize="12"
                   TextWrapping="Wrap" Margin="12" TextAlignment="Center" VerticalAlignment="Top">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasOutline}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <TreeView x:Name="Tree" ItemsSource="{Binding Outline}" Background="{DynamicResource Cor.FundoPainel}" BorderThickness="0"
                  Padding="8,10" SelectedItemChanged="Tree_SelectedItemChanged">
            <TreeView.Style>
                <Style TargetType="TreeView">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasOutline}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TreeView.Style>
            <TreeView.ItemContainerStyle>
                <!-- Expandido por padrão (brief pede navegação rápida, não uma árvore colapsada que o
                     usuário precisa abrir nó por nó pra achar "Capítulo 3") — 3 níveis de fixture-sumario
                     cabem confortavelmente expandidos no painel de 150px. -->
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="True"/>
                    <Setter Property="Foreground" Value="{DynamicResource Cor.TextoPrimario}"/>
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type editing:OutlineNode}" ItemsSource="{Binding Children}">
                    <!-- Nó SEM página (PageIndex null, ex.: "Anexos") continua visível na árvore — só
                         não é CLICÁVEL (brief: "nodes without page → not clickable/no-op") — o comando
                         no VM já trata isso como no-op; aqui só um cursor diferente sinaliza a diferença. -->
                    <!-- MouseLeftButtonUp (I2, revisão final pré-merge): clicar num nó JÁ selecionado
                         não dispara TreeView.SelectedItemChanged (WPF só dispara em MUDANÇA de seleção)
                         — "Capítulo 2", rolar pra outro lugar, "Capítulo 2" de novo não navegava de
                         volta. Exemplar: ThumbnailsPanel.Thumb_MouseLeftButtonUp (Border com
                         MouseLeftButtonUp cujo DataContext é o item). SelectedItemChanged continua
                         ligado (Tree_SelectedItemChanged, code-behind) pra navegação via TECLADO (setas)
                         — os 2 handlers convergem no MESMO ponto de entrada, ver doc XML lá. -->
                    <!-- Linha do Sumário (Plano 14 T3): ícone Phosphor mudo + label + número de página
                         mudo à direita; hover sutil na linha. A indentação por nível continua sendo a
                         nativa do TreeView (nenhuma aritmética de indent no XAML). O MouseLeftButtonUp
                         segue NO label (mesmo alvo dos testes de navegação) — clicar navega. -->
                    <Border CornerRadius="6" Padding="8,6" Margin="0,1" Background="Transparent">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Cor.SuperficieHover}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- O label (com o MouseLeftButtonUp) é declarado PRIMEIRO na ordem da árvore
                                 (posicionado na coluna 1 via Grid.Column) — os testes de navegação acham o
                                 PRIMEIRO TextBlock com DataContext=nó e disparam o clique NELE; como
                                 MouseLeftButtonUp é um evento DIRETO (não borbulha), o handler PRECISA
                                 estar exatamente nesse TextBlock. -->
                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Cor.TextoPrimario}" VerticalAlignment="Center"
                                       MouseLeftButtonUp="Node_MouseLeftButtonUp">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Cursor" Value="Arrow"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPage}" Value="True">
                                                <Setter Property="Cursor" Value="Hand"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="0" FontFamily="{DynamicResource Fonte.Phosphor}" FontSize="13"
                                       Foreground="{DynamicResource Cor.TextoSecundario}" Opacity="0.65"
                                       Text="{icons:PhosphorIcon book-open}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding PageIndex, Converter={StaticResource PaginaMaisUm}}"
                                       FontSize="11" Foreground="{DynamicResource Cor.TextoSecundario}" Opacity="0.6"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</UserControl>
