<UserControl x:Class="mPdf.App.Views.SearchBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <!-- Escape fecha; Enter/Shift+Enter navegam sem precisar tirar o foco do campo de busca — os
         InputBindings aqui são checados enquanto o KeyDown borbulha por dentro deste UserControl
         (o QueryBox é descendente dele), então funcionam com o foco no TextBox. -->
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
        <KeyBinding Key="Enter" Command="{Binding NextCommand}"/>
        <KeyBinding Key="Enter" Modifiers="Shift" Command="{Binding PreviousCommand}"/>
    </UserControl.InputBindings>
    <!-- Visibility no Border (filho), não na raiz do UserControl: StaticResource aninhado dentro de
         um Binding numa propriedade da PRÓPRIA raiz não enxerga o UserControl.Resources dessa mesma
         raiz (quirk conhecido do WPF — o elemento ainda não tem ancestrais na árvore lógica nesse
         ponto da resolução); um filho já enxerga normalmente. Collapsed no filho colapsa o layout do
         DockPanel.Dock="Top" pai (UserControl) do mesmo jeito. -->
    <Border Background="#FF3C3F41" BorderBrush="#FF232426" BorderThickness="0,0,0,1" Padding="8,6"
            Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">
        <StackPanel Orientation="Horizontal">
            <TextBox x:Name="QueryBox" Width="240" VerticalContentAlignment="Center"
                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="{Binding ResultCountLabel}" Foreground="White" VerticalAlignment="Center"
                       Margin="10,0" MinWidth="90"/>
            <Button Content="▲" Command="{Binding PreviousCommand}" Padding="8,2" Margin="2,0" ToolTip="Anterior (Shift+Enter)"/>
            <Button Content="▼" Command="{Binding NextCommand}" Padding="8,2" Margin="2,0" ToolTip="Próxima (Enter)"/>
            <Button Content="✕" Command="{Binding CloseCommand}" Padding="8,2" Margin="10,0,0,0" ToolTip="Fechar (Esc)"/>
        </StackPanel>
    </Border>
</UserControl>
