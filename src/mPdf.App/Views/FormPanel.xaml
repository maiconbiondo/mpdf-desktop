<UserControl x:Class="mPdf.App.Views.FormPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:mPdf.App.ViewModels"
             xmlns:editing="clr-namespace:mPdf.Editing;assembly=mPdf.Editing">
    <!-- Aba "Campos" (Task 2, Plano 3c) — DataContext esperado: um DocumentViewModel, mesmo contrato de
         ThumbnailsPanel/OutlineView (ver MainWindow.xaml, TabControl dentro do painel esquerdo
         colapsável). 3 estados mutuamente exclusivos (brief): XFA (aviso dedicado) | vazio ("não tem
         formulário") | normal (lista de editores + "Aplicar alterações") — exemplar: OutlineView
         (estado vazio via Style/DataTrigger em HasOutline). -->
    <UserControl.Resources>
        <!-- Task 2 (Plano 12): mescla o tema LOCALMENTE — este UserControl nunca é construído sozinho
             em teste (grep confirma, ver report), mas StaticResource resolve no MOMENTO em que o
             próprio InitializeComponent deste arquivo roda (antes de ser anexado como filho de
             MainWindow), então precisa da própria mescla — mesmo motivo/mesma nota de
             MainWindow.xaml. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/mPdf.App;component/Themes/mPdfTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{StaticResource Cor.Superficie}">
        <!-- Estado XFA (brief, texto EXATO da spec) — checado ANTES do vazio (2 TextBlocks nunca
             visíveis ao mesmo tempo: XFA sempre tem HasFormFields=False também, mas o aviso XFA é mais
             ESPECÍFICO e deve vencer). -->
        <TextBlock Text="Formulário XFA não é suportado; o documento abre para leitura."
                   Foreground="{StaticResource Cor.TextoSecundario}" FontSize="12" TextWrapping="Wrap" Margin="12"
                   TextAlignment="Center" VerticalAlignment="Top"
                   Visibility="{Binding IsXfaForm, Converter={StaticResource BoolToVis}}"/>
        <!-- Estado vazio (brief, texto EXATO) — só quando NÃO é XFA (aviso mais específico acima) E não
             há campos editáveis (AcroForm ausente, ou só campos Other/botão/assinatura). -->
        <TextBlock Text="Este documento não tem formulário." Foreground="{StaticResource Cor.TextoSecundario}" FontSize="12"
                   TextWrapping="Wrap" Margin="12" TextAlignment="Center" VerticalAlignment="Top">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsXfaForm}" Value="False"/>
                                <Condition Binding="{Binding HasFormFields}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <!-- Estado normal: HasFormFields=True (implica IsXfaForm=False por construção — ver
             DocumentViewModel.SeedFormFieldsCache/RefreshFormFieldsAsync, XFA nunca popula editores). -->
        <DockPanel Visibility="{Binding HasFormFields, Converter={StaticResource BoolToVis}}">
            <!-- Task 6 (Plano 4): aviso de preenchimento incremental — documento ASSINADO com DocMDP
                 permitindo (CanFillForms/ShowSignedFormFillNotice, ver doc XML na VM) continua editável,
                 mas o usuário precisa saber que o preenchimento vira uma revisão NOVA por cima da
                 assinatura existente. Texto EXATO do brief. Nunca aparece junto do estado "somente
                 leitura" (DocMDP proibindo/certificado sem permissão): nesse caso CanFillForms é false,
                 mesma bandeira que desabilita o ScrollViewer/botão abaixo — o banner GENÉRICO de
                 documento assinado (MainWindow) continua cobrindo esse caso, como sempre cobriu. -->
            <TextBlock DockPanel.Dock="Top" Text="Documento assinado: o preenchimento será adicionado sem invalidar a assinatura."
                       Foreground="{StaticResource Cor.TextoSecundario}" FontSize="11" TextWrapping="Wrap" Margin="8,8,8,0"
                       Visibility="{Binding ShowSignedFormFillNotice, Converter={StaticResource BoolToVis}}"/>
            <!-- M2 (revisão, Task 6/Plano 4): documento CERTIFICADO com DocMDP P=1 — nenhuma alteração é
                 permitida. Mutuamente exclusivo com o aviso ACIMA (dependem de valores diferentes de
                 SignedFillPermission). Sem isto, o painel só ficava cinzento com o banner GENÉRICO de
                 "documento assinado" por trás — o usuário não tinha como saber SE o motivo era XFA,
                 DocMDP, ou outra coisa; este texto nomeia a causa específica. Texto EXATO da revisão. -->
            <TextBlock DockPanel.Dock="Top" Text="Documento certificado: alterações não são permitidas (nível de proteção máximo)."
                       Foreground="{StaticResource Cor.TextoSecundario}" FontSize="11" TextWrapping="Wrap" Margin="8,8,8,0"
                       Visibility="{Binding ShowDocMdpDeniedNotice, Converter={StaticResource BoolToVis}}"/>
            <!-- Doc assinado SEM permissão de preenchimento (XFA) -> painel somente-leitura (brief):
                 CanFillForms já cobre botão + cada editor (IsEnabled cascateia — desabilitar aqui já
                 desabilita tudo dentro, mesmo que um editor individual tenha o PRÓPRIO IsEnabled=true
                 via IsEditable). O caso XFA continua sem aviso PRÓPRIO aqui (o painel de Campos já tem o
                 aviso XFA dedicado, mais acima nesta View, e HasFormFields nunca é true pra doc XFA de
                 qualquer forma) — só o caso DeniedByDocMdp precisava do aviso novo acima. -->
            <!-- Task 3 (Plano 3c): "Achatar formulário" — mesmo DockPanel.Dock="Bottom" de "Aplicar
                 alterações" (visível junto, HasFormFields já cobre "visible only when HasFormFields &&
                 !IsXfaForm" do brief: XFA nunca popula FormFieldEditors, ver DocumentViewModel.
                 CanFlattenForm). IsEnabled=CanEdit espelha o botão de aplicar (o Command.CanExecute já
                 cobre !EditInFlight via coerção do WPF — ver doc XML de CanFlattenForm). Achatar
                 CONTINUA gated por CanEdit (não CanFillForms) — a exceção do Plano 4 é só pro
                 PREENCHIMENTO, nunca pro achatamento de um documento assinado (fora de escopo, spec §5.2). -->
            <Button DockPanel.Dock="Bottom" Content="Achatar formulário"
                    Command="{Binding FlattenFormCommand}"
                    IsEnabled="{Binding CanEdit}" Margin="8,0,8,8" Padding="8,4" HorizontalAlignment="Stretch"
                    Style="{StaticResource mPdf.Button.Dialog}"/>
            <Button DockPanel.Dock="Bottom" Content="Aplicar alterações"
                    Command="{Binding ApplyFormValuesCommand}"
                    IsEnabled="{Binding CanFillForms}" Margin="8" Padding="8,4" HorizontalAlignment="Stretch"
                    Style="{StaticResource mPdf.Button.Dialog}"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" IsEnabled="{Binding CanFillForms}">
                <ItemsControl ItemsSource="{Binding FormFieldEditors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FormFieldViewModel}">
                            <Border Margin="8,4,8,8" BorderBrush="{StaticResource Cor.Borda}" BorderThickness="0,0,0,1"
                                    Padding="0,0,0,8">
                                <StackPanel>
                                    <!-- MouseLeftButtonUp NA PRÓPRIA TextBlock (exemplar EXATO:
                                         OutlineView.Node_MouseLeftButtonUp) — clicar no NOME do campo
                                         seleciona (destaque/scroll), SEMPRE — mesmo num campo readonly
                                         (brief: "IsReadOnly fields: display value, EDITOR disabled" —
                                         a seleção/destaque não é o editor, não pode ficar presa atrás de
                                         um IsEnabled=false; por isso o gate `IsEditable` abaixo envolve
                                         só o StackPanel INTERNO dos 5 editores, nunca este label). -->
                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource Cor.TextoPrimario}" Margin="0,0,0,4" Cursor="Hand"
                                               MouseLeftButtonUp="FieldBlock_MouseLeftButtonUp"/>

                                    <!-- Doc assinado -> painel somente-leitura (brief) via CanEdit no
                                         ScrollViewer externo (cascateia); campo IsReadOnly individual ->
                                         só o EDITOR (não o label acima) via IsEditable aqui. -->
                                    <StackPanel IsEnabled="{Binding IsEditable}">
                                    <!-- Text (inclui multilinha — mesmo editor, brief não distingue) -->
                                    <TextBox Text="{Binding EditedValue, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             MinHeight="24" MaxHeight="80" VerticalScrollBarVisibility="Auto">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static editing:FormFieldType.Text}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>

                                    <!-- Checkbox -->
                                    <CheckBox Content="Marcado" IsChecked="{Binding IsCheckboxOn}">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static editing:FormFieldType.Checkbox}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>

                                    <!-- Combo -->
                                    <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding EditedValue}">
                                        <ComboBox.Style>
                                            <Style TargetType="ComboBox">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static editing:FormFieldType.Combo}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.Style>
                                    </ComboBox>

                                    <!-- ListBox -->
                                    <ListBox ItemsSource="{Binding Options}" SelectedItem="{Binding EditedValue}" MaxHeight="90">
                                        <ListBox.Style>
                                            <Style TargetType="ListBox">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static editing:FormFieldType.ListBox}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListBox.Style>
                                    </ListBox>

                                    <!-- Radio: 1 RadioButton por Options — ver doc XML de
                                         FormPanel.xaml.cs (RadioOption_Loaded/RadioOption_Checked) pro
                                         porquê de precisar de EVENTOS aqui, não bindings puros. -->
                                    <ItemsControl ItemsSource="{Binding Options}">
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static editing:FormFieldType.Radio}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton Content="{Binding}"
                                                             GroupName="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.Name}"
                                                             Foreground="{StaticResource Cor.TextoPrimario}"
                                                             Loaded="RadioOption_Loaded"
                                                             Checked="RadioOption_Checked"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
