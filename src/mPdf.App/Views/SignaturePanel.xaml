<UserControl x:Class="mPdf.App.Views.SignaturePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:mPdf.App.ViewModels">
    <!-- Aba "Assinaturas" (Task 4, Plano 4) — DataContext esperado: um DocumentViewModel, mesmo contrato
         de ThumbnailsPanel/OutlineView/FormPanel (ver MainWindow.xaml, TabControl dentro do painel
         esquerdo colapsável). Somente-LEITURA (nenhum editor, ao contrário de FormPanel) — exemplar mais
         próximo: OutlineView (lista + estado vazio via Style/DataTrigger em HasOutline). Rodapé
         "Validação oficial" SEMPRE visível (brief) — fora do Grid condicional vazio/populado, DockPanel
         garante isso sem duplicar o TextBlock nos 2 estados. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <DockPanel Background="#FF3C3F41">
        <!-- Rodapé fixo (brief, texto EXATO) — DockPanel.Dock="Bottom" garante presença em QUALQUER
             estado (vazio ou com lista), nunca escondido atrás do estado vazio/populado abaixo. -->
        <TextBlock DockPanel.Dock="Bottom" Text="Validação oficial: validar.iti.gov.br"
                   Foreground="#FF999999" FontSize="10" TextWrapping="Wrap" Margin="8"
                   TextAlignment="Center"/>

        <!-- Estado vazio pt-BR (brief, texto EXATO) — visível por padrão, Collapsed via DataTrigger
             quando HasSignatures=True. Documento sem assinatura nenhuma (fixture-a4, por exemplo) ou o
             1º refresh assíncrono ainda em voo (ver doc XML de DocumentViewModel.SignatureRows) caem
             aqui — mesmo exemplar de OutlineView. -->
        <TextBlock Text="Este documento não tem assinaturas." Foreground="#FFCCCCCC" FontSize="12"
                   TextWrapping="Wrap" Margin="12" TextAlignment="Center" VerticalAlignment="Top">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSignatures}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSignatures}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <ItemsControl ItemsSource="{Binding SignatureRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SignatureRowViewModel}">
                        <Border Margin="8,4,8,8" BorderBrush="#FF555555" BorderThickness="0,0,0,1" Padding="0,0,0,8">
                            <StackPanel>
                                <!-- Signatário + tipo do certificado (brief: "kind icon e-CPF/e-CNPJ") —
                                     texto composto em DocumentViewModel.SignatureRowViewModel.SignerLine
                                     (revisão, item 2: MultiBinding/StringFormat direto no XAML produzia
                                     o artefato "Fulano  ()" quando DocumentKindLabel era vazio; a
                                     composição agora vive no VM, headless-testável, e só inclui o
                                     parêntese quando há um tipo pra mostrar). MouseLeftButtonUp NA
                                     PRÓPRIA TextBlock (exemplar EXATO:
                                     OutlineView.Node_MouseLeftButtonUp/FormPanel.FieldBlock_MouseLeftButtonUp)
                                     — clicar no nome seleciona/navega/destaca; cursor Hand só quando há
                                     carimbo pra navegar (HasStamp), Arrow caso contrário (assinatura
                                     "invisível" — clicável mas sem navegação/destaque, ver
                                     DocumentViewModel.SelectSignature). -->
                                <TextBlock Text="{Binding SignerLine}" FontSize="12" FontWeight="Bold"
                                           Foreground="#FFCCCCCC" Margin="0,0,0,4"
                                           MouseLeftButtonUp="Row_MouseLeftButtonUp">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Cursor" Value="Arrow"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasStamp}" Value="True">
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- CPF/CNPJ mascarado (revisão, item 1: computado/testado em
                                     DocumentNumberLabel, mas nunca bindado — o número que o brief lista
                                     como campo próprio ficava invisível pro usuário). Ausente por
                                     inteiro (nunca um rótulo vazio) quando o certificado não segue a
                                     convenção RFB — HasDocumentNumber gateia a Visibility. -->
                                <TextBlock Text="{Binding DocumentNumberLabel}" FontSize="11" Foreground="#FFCCCCCC"
                                           Margin="0,0,0,2"
                                           Visibility="{Binding HasDocumentNumber, Converter={StaticResource BoolToVis}}"/>

                                <TextBlock Text="{Binding DateLabel}" FontSize="11" Foreground="#FFCCCCCC" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding ReasonLabel}" FontSize="11" Foreground="#FFCCCCCC"
                                           TextWrapping="Wrap" Margin="0,0,0,4"/>

                                <!-- Indicador LOAD-BEARING (brief) — ✔/✖ Íntegra, cor reforça o sinal
                                     (verde/vermelho) sem depender só do glifo. -->
                                <TextBlock Text="{Binding IntegrityLabel}" FontSize="12" FontWeight="Bold" Margin="0,0,0,2">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#FF4CAF50"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Data.IntegrityValid}" Value="False">
                                                    <Setter Property="Foreground" Value="#FFE53935"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Item 1 (revisão I2, Task 6/Plano 4): rótulo honesto pode chegar a
                                     79-99 caracteres ("Cobre uma revisão anterior do documento (houve
                                     adições depois desta assinatura) — assinatura N de M") — sem
                                     TextWrapping="Wrap" ficava clipado a ~25 caracteres nos ~150px do
                                     painel (exemplar: ReasonLabel acima, mesmo padrão). -->
                                <TextBlock Text="{Binding CoverageLabel}" FontSize="11" Foreground="#FFCCCCCC"
                                           TextWrapping="Wrap" Margin="0,0,0,2"/>

                                <!-- "Cadeia confiável" com tooltip explicando não != forjada (brief). -->
                                <TextBlock Text="{Binding ChainTrustedLabel}" FontSize="11" Foreground="#FFCCCCCC"
                                           Margin="0,0,0,2" ToolTip="{Binding ChainTrustedTooltip}"/>

                                <!-- DocMDP — só aparece quando HasCertificationLabel (brief: FormsAndSignatures). -->
                                <TextBlock Text="{Binding CertificationLabel}" FontSize="11" FontStyle="Italic"
                                           Foreground="#FFCCCCCC"
                                           Visibility="{Binding HasCertificationLabel, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
