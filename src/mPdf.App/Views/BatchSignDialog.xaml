<Window x:Class="mPdf.App.Views.BatchSignDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:mPdf.App.ViewModels"
        xmlns:icons="clr-namespace:mPdf.App.Icons"
        Title="Assinar em lote" Height="612" Width="552" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" FontFamily="{DynamicResource Fonte.Inter}" Closing="Window_Closing">
    <Window.Resources>
        <!-- Task 2 (Plano 12, rider) — mescla o tema LOCALMENTE, mesmo motivo dos outros diálogos
             (Application.Current fica null nas sondas STA que constroem este diálogo direto). -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/mPdf.App;component/Themes/mPdfTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>
    <Border Style="{StaticResource mPdf.Dialog.Superficie}" Margin="16">
        <DockPanel>
            <!-- Header: stack. -->
            <Border DockPanel.Dock="Top" Background="Transparent" BorderBrush="{DynamicResource Cor.BordaSutil}"
                    BorderThickness="0,0,0,1" Padding="22,18" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource mPdf.Dialog.IconeHeader}">
                        <TextBlock FontFamily="{DynamicResource Fonte.PhosphorFill}" FontSize="17" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Text="{icons:PhosphorIcon stack}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="11,0,0,0">
                        <TextBlock Text="Assinar em lote" Style="{StaticResource mPdf.Dialog.Titulo}"/>
                        <TextBlock Text="Padrão PAdES · ICP-Brasil" Style="{StaticResource mPdf.Dialog.Subtitulo}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Rodapé: Cancelar assinatura (em execução) / Fechar / Assinar. -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource Cor.FundoDialogoRodape}"
                    BorderBrush="{DynamicResource Cor.BordaSutil}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,13,13" Padding="22,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar assinatura" Margin="0,0,10,0"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                            Command="{Binding CancelCommand}" Style="{StaticResource mPdf.Button.DialogCancelar}"/>
                    <Button Content="Fechar" Margin="0,0,10,0" IsCancel="True" Style="{StaticResource mPdf.Button.DialogCancelar}"/>
                    <Button Command="{Binding StartCommand}"
                            Visibility="{Binding CanEditList, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource mPdf.Button.DialogPrimario}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{DynamicResource Fonte.PhosphorFill}" FontSize="14" VerticalAlignment="Center"
                                       Margin="0,0,7,0" Text="{icons:PhosphorIcon pen-nib}"/>
                            <TextBlock Text="Assinar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Grid>
                <!-- Fase EDIÇÃO: lista de arquivos + certificado + motivo/local + carimbo. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding CanEditList, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="22,18">
                        <!-- Aviso de arquivo(s) recusado(s) por já estar(em) aberto(s) numa aba. -->
                        <Border Background="#1AB00020" BorderBrush="#40B00020" BorderThickness="1" CornerRadius="8"
                                Padding="11,9" Margin="0,0,0,14"
                                Visibility="{Binding AddFilesNotice, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                            <TextBlock Text="{Binding AddFilesNotice}" Foreground="#FFFF9AA6" TextWrapping="Wrap" FontSize="12"/>
                        </Border>

                        <TextBlock Text="Arquivos a assinar" Style="{StaticResource mPdf.Dialog.LabelForte}"/>
                        <ListBox x:Name="FilesList" ItemsSource="{Binding Files}" MaxHeight="132" Background="Transparent"
                                 BorderThickness="0" Padding="0" Margin="0,0,0,8"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="0,0,0,5"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="#05E9E9ED" BorderBrush="{DynamicResource Cor.BordaSutil}"
                                                        BorderThickness="1" CornerRadius="8" Padding="11,9" SnapsToDevicePixels="True">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock FontFamily="{DynamicResource Fonte.Phosphor}" FontSize="16"
                                                                   Foreground="{DynamicResource Cor.IconeAzul}" VerticalAlignment="Center"
                                                                   Margin="0,0,10,0" Text="{icons:PhosphorIcon file-text}"/>
                                                        <TextBlock Text="{Binding}" FontSize="12.5"
                                                                   Foreground="{DynamicResource Cor.TextoPrimario}"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Cor.SuperficieHover}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#1A4D8FD6"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Cor.Primaria}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Command="{Binding AddFilesCommand}" Margin="0,0,8,0" Style="{StaticResource mPdf.Button.DialogSuaveAzul}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{DynamicResource Fonte.Phosphor}" FontSize="14" VerticalAlignment="Center"
                                               Margin="0,0,6,0" Text="{icons:PhosphorIcon plus}"/>
                                    <TextBlock Text="Adicionar arquivos…" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Content="Remover" Click="Remove_Click" Style="{StaticResource mPdf.Button.DialogNeutro}"/>
                        </StackPanel>

                        <TextBlock Text="Certificado" Style="{StaticResource mPdf.Dialog.LabelForte}"/>
                        <!-- Certificados ECC listados (nunca filtrados) mas desabilitados, mesmo padrão de
                             Views.SignDialog (ver BatchCertificateItem). Cartões: ver mPdf.CertCard.*. -->
                        <ListBox x:Name="CertificateListBox" ItemsSource="{Binding Certificates}"
                                 SelectedItem="{Binding SelectedCertificate}" MaxHeight="150"
                                 KeyboardNavigation.TabNavigation="Continue" Style="{StaticResource mPdf.CertCard.ListBox}"/>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Motivo (opcional)" Style="{StaticResource mPdf.Dialog.Label}"/>
                                <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource mPdf.Input}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Local (opcional)" Style="{StaticResource mPdf.Dialog.Label}"/>
                                <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource mPdf.Input}"/>
                            </StackPanel>
                        </Grid>

                        <!-- DocMDP nunca oferecido em lote (decisão do plano). -->
                        <TextBlock Text="Carimbo visível" Style="{StaticResource mPdf.Dialog.LabelForte}" Margin="0,16,0,8"/>
                        <RadioButton x:Name="NoStampRadio" GroupName="Stamp" Checked="NoStampRadio_Checked"
                                     Margin="0,0,0,7" Style="{StaticResource mPdf.CarimboCard}">
                            <TextBlock Text="Sem carimbo" FontSize="12.5" HorizontalAlignment="Left"/>
                        </RadioButton>
                        <RadioButton x:Name="PlaceStampRadio" GroupName="Stamp" Checked="PlaceStampRadio_Checked"
                                     Style="{StaticResource mPdf.CarimboCard}">
                            <TextBlock Text="Carimbo na última página (canto inferior direito)" FontSize="12.5" HorizontalAlignment="Left"/>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>

                <!-- Fase EXECUÇÃO: progresso. -->
                <StackPanel Margin="22,20" VerticalAlignment="Center"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ProgressText}" FontSize="14" TextAlignment="Center" Margin="0,0,0,12"
                               Foreground="{DynamicResource Cor.TextoPrimario}"/>
                    <ProgressBar IsIndeterminate="True" Height="18"/>
                </StackPanel>

                <!-- Fase CONCLUÍDO: resultado por arquivo, símbolo de sucesso/falha. -->
                <DockPanel Margin="22,20" Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}">
                    <TextBlock DockPanel.Dock="Top" Text="Lote cancelado. Os arquivos restantes não foram processados."
                               Foreground="{DynamicResource Cor.Erro}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding WasCancelled, Converter={StaticResource BoolToVis}}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Results}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BatchSignFileResult}">
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Cor.Sucesso}"/>
                                                <Setter Property="Text">
                                                    <Setter.Value>
                                                        <MultiBinding StringFormat="✔ {0}">
                                                            <Binding Path="Message"/>
                                                        </MultiBinding>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Succeeded}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource Cor.Erro}"/>
                                                        <Setter Property="Text">
                                                            <Setter.Value>
                                                                <MultiBinding StringFormat="✖ {0}">
                                                                    <Binding Path="Message"/>
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
