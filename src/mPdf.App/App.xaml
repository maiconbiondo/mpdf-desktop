<Application x:Class="mPdf.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:mPdf.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Plano 12 (Task 1): tema visual central — tokens de cor/espaçamento/raio + estilos de
             chrome (ToolBar/TabControl/Menu/GroupBox globais; Button/Border KEYED, ver nota de
             escopo no topo de Themes/mPdfTheme.xaml). Mesclado aqui pra ficar disponível como
             StaticResource em QUALQUER Window/UserControl do app (App.Resources é a raiz de busca
             de recursos de toda a árvore visual). -->
        <!-- Plano 14 (Task 1): [dicionário de TOKENS ativo, ESTRUTURA]. O dicionário de tokens
             (Tokens.Escuro.xaml = PADRÃO v2.0) fica ANTES de mPdfTheme.xaml; ThemeService troca esse
             dicionário ativo em runtime (remove o Tokens.* atual, insere o novo no índice 0) e os
             {DynamicResource Cor.*} de mPdfTheme re-resolvem AO VIVO. Chaves disjuntas (mPdfTheme só
             tem Esp/Raio/Fonte/estilos; os Cor.* só nos Tokens.*), então a ordem é segura. O tema
             INICIAL vem de AppConfig.ThemeMode (default Escuro), aplicado no App.OnStartup — se o
             usuário tiver escolhido Claro, ThemeService.AplicarNoApp troca antes da janela aparecer. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Tokens.Escuro.xaml"/>
                <ResourceDictionary Source="Themes/mPdfTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
