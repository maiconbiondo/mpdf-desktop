<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
    Plano 12 (Task 1) — Sistema de tema visual do mPDF (CHROME-ONLY).

    Objetivo: dar uma cara mais bonita/profissional ao app SEM tocar no pipeline de render (a
    velocidade elogiada pelo usuário vem da virtualização da ListBox + PDFium, INTOCADOS aqui —
    nenhum arquivo de Rendering/ViewModels de página é tocado por este dicionário).

    PROIBIÇÃO ESTRUTURAL (ver ThemeStructuralTests): nenhum DropShadowEffect/BlurEffect/<*.Effect>,
    nenhum BeginStoryboard/animação contínua, nenhum Opacity com valor fracionário (<1) em NADA
    deste arquivo — hover/pressed/foco são SEMPRE troca de Background/BorderBrush SÓLIDO (barato:
    só recompõe a pintura do Border, não recalcula layout nem invalida a árvore de render das
    páginas). Brushes definidos aqui como recursos de nível de dicionário são congelados (Frozen)
    automaticamente pelo WPF quando não têm binding/trigger de instância — compartilhados por
    referência entre TODOS os controles que os usam, sem alocação por controle.

    ESCOPO (KEYED vs GLOBAL — decisão registrada por controle, ver task-1-report.md para a tabela
    completa):
      - ToolBar/ToolBarTray/Separator/TabControl/TabItem/Menu/MenuItem/GroupBox: estilos GLOBAIS
        (sem x:Key, TargetType implícito) — verificado por grep em todo src/mPdf.App/**/*.xaml que
        NENHUM destes tipos aparece dentro de Views/PdfViewerControl.xaml (a única árvore visual de
        RENDER/OVERLAY/adorner do app — página, seleção, caixa do carimbo, alças). Um estilo global
        para estes tipos não pode vazar pra dentro do viewer.
      - Button/Border: estilos KEYED (x:Key explícito, aplicados só onde referenciados). Button
        aparece DENTRO do overlay de render (Views/PdfViewerControl.xaml: botões flutuantes
        "✔ Assinar aqui" / "✖ Cancelar" do adorner da caixa de assinatura, sem x:Key hoje) — um
        Style TargetType="Button" SEM x:Key restilizaria esses botões do overlay também, fora do
        escopo desta task ("chrome only"). Border também aparece no overlay (o Border de CADA
        página, x:Name="PageBorder", com Background="White" explícito e o DropShadowEffect já
        existente ali — pré-existente, fora do escopo desta task) — um Style TargetType="Border"
        global restilizaria o fundo/cantos de TODA página renderizada. Por isso os dois ficam KEYED
        (mPdf.Button.Toolbar / mPdf.Button.Dialog / mPdf.Border.Painel) — quem quiser o visual novo
        referencia via Style="{StaticResource ...}" explicitamente (Task 2 faz essa fiação no chrome;
        Task 1 só disponibiliza os estilos, mesclados no App.xaml).
    -->

    <!-- ================================ TOKENS DE COR ================================
         Paleta derivada da logo aprovada (Plano 8): azul-marinho #1D4E89 + verde-água #3EC1A7.
         Cor.TextoPrimario reusa o azul-marinho ESCURO já usado na dobra da logo (#0F2E52,
         Assets/logo.svg) em vez de um preto genérico — reforça a identidade sem sacrificar
         contraste (ver tabela de razões WCAG no report). Tema CLARO fixo (sem SystemColors que
         invertem — nenhuma referência a SystemColors.* neste arquivo; dark mode é escopo próprio,
         fora desta task). -->
    <SolidColorBrush x:Key="Cor.Primaria" Color="#FF1D4E89"/>
    <SolidColorBrush x:Key="Cor.Acento" Color="#FF3EC1A7"/>
    <SolidColorBrush x:Key="Cor.Superficie" Color="#FFF5F7FA"/>
    <SolidColorBrush x:Key="Cor.Borda" Color="#FFC7D1DC"/>
    <SolidColorBrush x:Key="Cor.TextoPrimario" Color="#FF0F2E52"/>
    <SolidColorBrush x:Key="Cor.TextoSecundario" Color="#FF52606D"/>

    <!-- Tokens de apoio (fora da lista nomeada do brief, mas necessários pros estados de
         interação — sempre troca de Background SÓLIDA, nunca Opacity/animação). -->
    <SolidColorBrush x:Key="Cor.SuperficieHover" Color="#FFE3ECF5"/>
    <SolidColorBrush x:Key="Cor.SuperficiePressionada" Color="#FFCFE0F0"/>
    <SolidColorBrush x:Key="Cor.TextoDesabilitado" Color="#FFAEB4BC"/>

    <!-- Plano 12 (Task 2, rider do coordenador) — tokens SEMÂNTICOS de status (sucesso/erro), usados
         pelo indicador ✔/✖ Íntegra do SignaturePanel (antes cores soltas #FF4CAF50/#FFE53935,
         escolhidas pro fundo ESCURO #FF3C3F41 do painel — 2.59:1/3.94:1 contra o novo
         Cor.Superficie claro, ambos FALHAM o piso AA de 4.5:1, recomputado em
         ThemeContrastTests). Valores reaproveitados de tons JÁ usados em outros lugares do app pra
         mensagem de sucesso/erro sobre fundo CLARO (SobreDialog "já está atualizado" = #FF2E7D32;
         ExportImageDialog/BatchSignDialog "falha ao exportar"/cancelado = #FFB00020) — nada inventado,
         só centralizado num token pra reuso e pra ThemeContrastTests conseguir vigiar. -->
    <SolidColorBrush x:Key="Cor.Sucesso" Color="#FF2E7D32"/>
    <SolidColorBrush x:Key="Cor.Erro" Color="#FFB00020"/>

    <!-- ============================ ESCALA DE ESPAÇAMENTO ============================
         Thickness (não Double): consumo real é Padding/Margin, cujo tipo é Thickness — um
         recurso Double não converte automaticamente para Thickness via StaticResource (só via
         string no XAML), então o token já nasce no tipo que os Setters abaixo realmente usam. -->
    <Thickness x:Key="Esp.P">4</Thickness>
    <Thickness x:Key="Esp.M">8</Thickness>
    <Thickness x:Key="Esp.G">16</Thickness>

    <!-- ================================ RAIOS DE CANTO ================================ -->
    <CornerRadius x:Key="Raio.P">4</CornerRadius>
    <CornerRadius x:Key="Raio.M">8</CornerRadius>

    <!-- =========================== ToolBar / ToolBarTray =========================== -->
    <Style TargetType="ToolBarTray">
        <Setter Property="Background" Value="{StaticResource Cor.Superficie}"/>
    </Style>

    <Style TargetType="ToolBar">
        <Setter Property="Background" Value="{StaticResource Cor.Superficie}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Cor.Borda}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="{StaticResource Esp.P}"/>
    </Style>

    <!-- Usado pelos separadores DENTRO da ToolBar (única aparição do tipo no app hoje, ver
         MainWindow.xaml e PageOrganizerView.xaml — nenhum dentro do overlay de render). -->
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource Cor.Borda}"/>
        <Setter Property="Margin" Value="4,4,4,4"/>
    </Style>

    <!-- ================================ TabControl / TabItem ================================
         "Aba ativa com acento, inativa neutra" (brief): a aba SELECIONADA ganha uma faixa inferior
         sólida em Cor.Acento (verde-água) + fundo branco + texto em Cor.TextoPrimario; as INATIVAS
         ficam com fundo Cor.Superficie (neutro) + texto Cor.TextoSecundario. Texto branco sobre
         Cor.Acento FALHA contraste (2.24:1, ver report) — por isso o acento aparece só como faixa
         decorativa fina, nunca como fundo atrás de texto. TabControl fica com Setters simples (sem
         ControlTemplate custom) — o template padrão já faz TemplateBinding de Background/
         BorderBrush; retemplar o TabControl inteiro (PART_SelectedContentHost etc.) não é
         necessário pro que o brief pede e adicionaria risco sem ganho visual. -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{StaticResource Cor.Superficie}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Cor.Borda}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource Cor.TextoSecundario}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <!-- Default 12,6 pra quem NÃO fixa Padding localmente (ex.: os TabItem gerados pelo
             ItemContainerStyle implícito do TabControl de documentos, "Tabs" em MainWindow.xaml,
             que não declara Padding próprio) — instâncias que JÁ fixam Padding localmente (as 4
             abas do painel esquerdo, Padding="6,3" em MainWindow.xaml) sobrescrevem este default
             normalmente (valor local > Setter de Style), DESDE que o ControlTemplate abaixo
             respeite via TemplateBinding em vez de hardcodar — achado ao vivo na sonda visual:
             a 1ª versão deste template hardcodava Padding="12,6" direto no Border, ignorando por
             completo o Padding="6,3" já escrito em MainWindow.xaml e estourando a largura das 4
             abas do painel de 150px pra 2 LINHAS de abas (regressão de densidade visível na
             sonda). -->
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <!-- Grid (não Border único): a faixa de acento é um elemento SEPARADO
                         (Underline) posicionado por cima da borda inferior do "Corpo" — trocar só
                         a Visibility dela em vez de recompor BorderThickness por lado evita ter que
                         reconstruir o Border a cada seleção (troca de estado = 1 Setter, barato). -->
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Corpo" Background="{StaticResource Cor.Superficie}"
                                BorderBrush="{StaticResource Cor.Borda}" BorderThickness="1,1,1,0"
                                CornerRadius="4,4,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="Conteudo" ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <Border x:Name="Faixa" Height="3" VerticalAlignment="Bottom" Margin="1,0,1,0"
                                Background="{StaticResource Cor.Acento}" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Corpo" Property="Background" Value="{StaticResource Cor.SuperficieHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Corpo" Property="Background" Value="White"/>
                            <Setter TargetName="Faixa" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{StaticResource Cor.TextoPrimario}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Panel.ZIndex" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================ Menu / MenuItem ================================
         Setters simples (sem ControlTemplate custom): o único Menu do app hoje é "Recentes" na
         ToolBar (MainWindow.xaml), 1 nível, submenu dinâmico via ItemsSource — retemplar
         MenuItem inteiro (ícone/checkmark/seta de submenu/Popup) pra ganhar hover exato no
         acento é risco desproporcional ao ganho (o item só aparece fechado na sonda visual
         estática; o hover ao vivo continua com o destaque padrão do Windows onde o Setter não
         alcança — limitação conhecida, registrada no report). Os Setters abaixo SIM valem pro
         estado ocioso (o que a sonda visual e o usuário veem na maior parte do tempo). -->
    <Style TargetType="Menu">
        <Setter Property="Background" Value="{StaticResource Cor.Superficie}"/>
        <Setter Property="Foreground" Value="{StaticResource Cor.TextoPrimario}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Cor.TextoPrimario}"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>

    <!-- ================================ GroupBox ================================
         Não usado hoje em nenhum XAML do app (confirmado por grep) — disponibilizado pro Task 2/
         diálogos futuros. Setters simples: o template padrão do GroupBox faz TemplateBinding de
         BorderBrush/Background/Padding, então isto já basta sem retemplate. -->
    <Style TargetType="GroupBox">
        <Setter Property="BorderBrush" Value="{StaticResource Cor.Borda}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Cor.TextoPrimario}"/>
        <Setter Property="Padding" Value="{StaticResource Esp.M}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ================================ Button — KEYED (ver nota de escopo no topo) ================================
         Os dois estilos abaixo NÃO têm x:Key coincidindo com TargetType Button implícito — são
         opt-in. FocusVisualStyle="{x:Null}" desliga o retângulo pontilhado padrão do Windows
         (que não combina com cantos arredondados) — o foco visível vira o próprio BorderBrush do
         botão virando Cor.Acento com 2px sólidos no trigger IsKeyboardFocused, sempre um Setter de
         cor sólida, nunca Effect/animação. Estado desabilitado troca só o Foreground por um token
         dedicado (Cor.TextoDesabilitado) em vez de Opacity fracionário — a suíte estrutural varre
         por "Opacity=\"0" e qualquer fração (0.4, 0.5...) bateria nesse grep, então o "desabilitado"
         também é 100% cor sólida aqui. BorderBrush NÃO muda no disabled (fica Transparent, herdado
         do estado ocioso) — nenhum token de borda desabilitada existe hoje ("Cor.BordaDesabilitada"
         era citado nesta doc mas nunca foi definido no dicionário; corrigido — se um dia um contorno
         desabilitado for desejado, defina o token de verdade ANTES de citá-lo aqui). -->
    <Style x:Key="mPdf.Button.Toolbar" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Cor.TextoPrimario}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <!-- BorderThickness=0 ocioso (Task 2, achado do portão de performance/overflow): um contorno
             BorderBrush=Transparent de qualquer espessura já é INVISÍVEL (nada é pintado) — mas
             continuava CONSUMINDO espaço de layout (1px de cada lado) por nenhum ganho visual
             nenhum, e multiplicado pelos ~19-25 botões de CADA banda da ToolBarTray, isso sozinho
             empurrou a sonda de overflow (ViewerIntegrationTests.
             MainWindow_At1200x800_ToolbarsHaveNoOverflowItems) pro vermelho ao ligar este Style pela
             1ª vez (medido ao vivo). 0 aqui é estritamente mais barato E pixel-idêntico no estado
             ocioso/hover/pressed (nenhum dos 3 muda BorderBrush, só Background) — só o foco de
             teclado abaixo (IsKeyboardFocused) precisa de espessura de verdade pra desenhar o anel de
             foco, e SÓ nesse estado ela custa layout (raro/transiente, não a medida "padrão" que a
             sonda de overflow cobre). mPdf.Button.Dialog (abaixo) sobrescreve pra 1 de propósito — lá
             a borda É visível por padrão (Cor.Borda, não Transparent), custar layout ali é o preço
             certo de um contorno que aparece na tela. -->
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Raio.P}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Cor.SuperficieHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Cor.SuperficiePressionada}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Cor.Acento}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Cor.TextoDesabilitado}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Variante de diálogo: mesma mecânica de estados do toolbar acima, fundo/borda visíveis por
         padrão (botões OK/Cancelar precisam se destacar sozinhos, sem uma ToolBar ao redor pra dar
         contexto) e padding mais generoso (Esp.G horizontal). -->
    <Style x:Key="mPdf.Button.Dialog" TargetType="Button" BasedOn="{StaticResource mPdf.Button.Toolbar}">
        <Setter Property="Background" Value="{StaticResource Cor.Superficie}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Cor.Borda}"/>
        <!-- Sobrescreve o BorderThickness=0 herdado do Toolbar acima DE PROPÓSITO: aqui o
             BorderBrush É visível (Cor.Borda, não Transparent) — sem isto o botão de diálogo perderia
             o contorno que o torna reconhecível como botão fora de uma ToolBar (ver comentário
             original abaixo). -->
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,6"/>
        <Setter Property="MinWidth" Value="80"/>
    </Style>

    <!-- ================================ Border de painel — KEYED ================================
         Pra containers de chrome (ex.: coluna de miniaturas/sumário, rodapés de diálogo) — nunca
         aplicado a um Border dentro de PdfViewerControl.xaml (a página em si é PdfViewerControl,
         não um painel de chrome). -->
    <Style x:Key="mPdf.Border.Painel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Cor.Superficie}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Cor.Borda}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Raio.M}"/>
        <Setter Property="Padding" Value="{StaticResource Esp.M}"/>
    </Style>

</ResourceDictionary>
